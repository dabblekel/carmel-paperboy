{
  "name": "playable-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable browser viewer for Paperboy worlds exported from Blender as GLB.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node tools/validate-glb.mjs",
    "baseline": "node tools/capture-baseline.mjs"
  },
  "dependencies": {
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
